# Copy to .env and fill in. Never commit real values.

# Local database from docker-compose.yml
DATABASE_URL="postgresql://bottega:bottega@localhost:5432/bottega?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Cloudflare R2 (photos) — not needed until the photos module
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="bottega-photos"

# Base URL printed in ticket QR codes
APP_URL="http://localhost:3000"
